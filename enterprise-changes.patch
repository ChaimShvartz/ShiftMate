+  color: var(--text-3);
+}
+
+.swap-card__apply-btn {
+  border: 0;
+  background: var(--action);
+  color: var(--action-text);
+  padding: 7px 16px;
+  border-radius: var(--radius-sm);
+  font-weight: 600;
+  font-size: 12.5px;
+  transition: all 0.15s ease;
+  cursor: pointer;
+}
+
+.swap-card__apply-btn:hover:not(:disabled) {
+  background: var(--action-hover);
+}
+
+.timeline {
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+}
+
+.timeline-item {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: 12px;
+  padding: 14px 16px;
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+  transition: border-color 0.15s;
+}
+
+.timeline-item:hover {
+  border-color: var(--border-strong);
+}
+
+.timeline-item__main {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+}
+
+/* ---------- 8. Manager Schedule Grid ----------------------------------- */
+.schedule-controls {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 14px;
+  flex-wrap: wrap;
+  margin-bottom: 20px;
+}
+
+.schedule-grid-wrap {
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-lg);
+  box-shadow: var(--shadow-sm);
+  overflow-x: auto;
+}
+
+.schedule-table {
+  width: 100%;
+  border-collapse: collapse;
+  text-align: start;
+}
+
+.schedule-table th, .schedule-table td {
+  padding: 12px 14px;
+  border-bottom: 1px solid var(--border);
+  border-inline-end: 1px solid var(--border);
+  vertical-align: top;
+}
+
+.schedule-table th:last-child, .schedule-table td:last-child {
+  border-inline-end: 0;
+}
+
+.schedule-table th {
+  background: var(--surface-2);
+  font-size: 12.5px;
+  font-weight: 600;
+  color: var(--text-2);
+}
+
+.schedule-cell-shifts {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  min-height: 80px;
+}
+
+.schedule-shift-item {
+  background: var(--surface-2);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-sm);
+  padding: 8px 10px;
+  font-size: 12px;
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  cursor: pointer;
+  transition: border-color 0.15s;
+}
+
+.schedule-shift-item:hover {
+  border-color: var(--brand);
+}
+
+/* ---------- 9. Admin Tables --------------------------------------------- */
+.admin-table-wrap, .users-table-container, .units-section-container {
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-lg);
+  box-shadow: var(--shadow-sm);
+  overflow: hidden;
+  margin-bottom: 24px;
+}
+
+.table-toolbar {
+  padding: 14px 18px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  flex-wrap: wrap;
+  border-bottom: 1px solid var(--border);
+  background: var(--surface-2);
+}
+
+.table-toolbar input[type="text"] {
+  max-width: 280px;
+}
+
+.data-table, .users-table {
+  width: 100%;
+  border-collapse: collapse;
+  text-align: start;
+}
+
+.data-table th, .users-table th {
+  background: var(--surface-2);
+  padding: 11px 16px;
+  font-size: 12px;
+  font-weight: 600;
+  text-transform: uppercase;
+  letter-spacing: 0.04em;
+  color: var(--text-2);
+  border-bottom: 1px solid var(--border);
+  white-space: nowrap;
+}
+
+.data-table td, .users-table td {
+  padding: 12px 16px;
+  border-bottom: 1px solid var(--border);
+  font-size: 13.5px;
+  color: var(--text);
+}
+
+.data-table tr:hover, .users-table tr:hover {
+  background: var(--surface-hover);
+}
+
+.table-actions {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+
+/* ---------- 10. Modals & Dialogs ---------------------------------------- */
+.modal-backdrop {
+  position: fixed;
+  inset: 0;
+  z-index: 100;
+  display: grid;
+  place-items: center;
+  padding: 20px;
+  background: rgba(15, 23, 42, 0.65);
+  overflow-y: auto;
+}
+
+.modal-content {
+  width: min(520px, 100%);
+  max-height: calc(100vh - 40px);
+  overflow-y: auto;
+  background: var(--surface);
+  border: 1px solid var(--border-strong);
+  border-radius: var(--radius-xl);
+  padding: 24px 28px;
+  box-shadow: var(--shadow-lg);
+  position: relative;
+}
+
+.modal-content--sm {
+  width: min(420px, 100%);
+}
+
+.modal-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  margin-bottom: 14px;
+}
+
+.modal-header h3 {
+  font-size: 18px;
+  font-weight: 700;
+  letter-spacing: -0.01em;
+}
+
+.btn-close {
+  width: 30px;
+  height: 30px;
+  border-radius: var(--radius-sm);
+  border: 1px solid var(--border);
+  background: var(--surface-2);
+  color: var(--text-2);
+  display: grid;
+  place-items: center;
+  cursor: pointer;
+  transition: all 0.15s;
+}
+
+.btn-close:hover {
+  background: var(--danger-soft);
+  color: var(--danger);
+  border-color: var(--danger);
+}
+
+.modal-subtitle, .confirm-text {
+  color: var(--text-2);
+  font-size: 13px;
+  margin-bottom: 16px;
+  line-height: 1.5;
+}
+
+.modal-actions {
+  display: flex;
+  gap: 10px;
+  margin-top: 20px;
+}
+
+.rule-notice-box, .role-notice-card, .current-manager-banner, .template-download-section, .selected-file-info {
+  padding: 12px 14px;
+  border-radius: var(--radius);
+  background: var(--info-soft);
+  color: var(--info-text);
+  margin-bottom: 14px;
+  font-size: 13px;
+  border: 1px solid rgba(37, 99, 235, 0.2);
+}
+
+.template-download-section {
+  background: var(--surface-2);
+  color: var(--text-2);
+  border-color: var(--border);
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  align-items: flex-start;
+}
+
+.selected-file-info {
+  background: var(--success-soft);
+  color: var(--success-text);
+  border-color: rgba(22, 163, 74, 0.25);
+}
+
+.modal-success-content, .admin-code-card {
+  text-align: center;
+  padding: 8px 0;
+}
+
+.code-box, .admin-code-card {
+  background: var(--surface-2);
+  border: 1px dashed var(--border-strong);
+  border-radius: var(--radius);
+  padding: 18px;
+  margin: 14px 0;
+}
+
+.code-label {
+  color: var(--text-3);
+  font-size: 12px;
+}
+
+.code-value, .admin-code-display {
+  font-family: var(--font-mono);
+  font-size: 32px;
+  font-weight: 700;
+  letter-spacing: 0.15em;
+  color: var(--brand);
+  direction: ltr;
+}
+
+/* Toast System */
+.toast-container {
+  position: fixed;
+  z-index: 200;
+  inset-inline-start: 24px;
+  bottom: 24px;
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  width: min(380px, calc(100vw - 48px));
+  pointer-events: none;
+}
+
+.toast {
+  pointer-events: auto;
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 12px 16px;
+  background: var(--surface);
+  border: 1px solid var(--border-strong);
+  border-radius: var(--radius);
+  box-shadow: var(--shadow-md);
+}
+
+.toast--success { border-color: rgba(22, 163, 74, 0.4); }
+.toast--warning { border-color: rgba(217, 119, 6, 0.4); }
+.toast--error { border-color: rgba(220, 38, 38, 0.4); }
+
+.toast__message {
+  flex: 1;
+  font-size: 13px;
+  color: var(--text);
+  font-weight: 500;
+}
+
+.toast__close {
+  border: 0;
+  background: none;
+  color: var(--text-3);
+  font-size: 16px;
+  cursor: pointer;
+}
+.toast__close:hover { color: var(--text); }
+
+/* ---------- 11. Auth & Profile Pages ------------------------------------ */
+.login-page, .setup-page, .not-found-page {
+  position: relative;
+  min-height: 100vh;
+  display: grid;
+  place-items: center;
+  padding: 24px;
+  background: var(--bg);
+}
+
+.login-theme {
+  position: absolute;
+  top: 20px;
+  inset-inline-start: 20px;
+  z-index: 2;
+}
+
+.login-card, .setup-form-container, .setup-success-container, .not-found-card {
+  position: relative;
+  z-index: 1;
+  width: min(420px, 100%);
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-xl);
+  padding: 36px 32px;
+  box-shadow: var(--shadow-md);
+}
+
+.login-header, .setup-header {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  text-align: center;
+  gap: 10px;
+  margin-bottom: 24px;
+}
+
+.login-subtitle, .setup-header p {
+  color: var(--text-2);
+  font-size: 13px;
+}
+
+.system-uninitialized-banner {
+  padding: 10px 14px;
+  border-radius: var(--radius);
+  background: var(--warning-soft);
+  color: var(--warning-text);
+  margin-bottom: 18px;
+  font-size: 13px;
+  text-align: center;
+  border: 1px solid rgba(217, 119, 6, 0.25);
+}
+
+.system-uninitialized-banner a {
+  font-weight: 600;
+  text-decoration: underline;
+}
+
+.profile-page {
+  max-width: 640px;
+}
+
+.profile-card {
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-xl);
+  padding: 32px 28px;
+  box-shadow: var(--shadow-sm);
+}
+
+.profile-avatar {
+  width: 72px;
+  height: 72px;
+  margin: 0 auto 14px;
+  border-radius: var(--radius-lg);
+  background: var(--brand);
+  color: #fff;
+  display: grid;
+  place-items: center;
+  font-size: 28px;
+  font-weight: 700;
+}
+
+.profile-card__name {
+  text-align: center;
+  font-size: 22px;
+  font-weight: 700;
+  color: var(--text);
+}
+
+.profile-meta-badges {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: 6px;
+  margin: 10px 0 24px;
+}
+
+.profile-meta-badges > span {
+  font-size: 12px;
+}
+
+.profile-form-grid {
+  display: grid;
+  gap: 14px;
+}
+
+.not-found-card {
+  text-align: center;
+}
+
+.not-found-card h1 {
+  font-size: 72px;
+  font-weight: 800;
+  line-height: 1;
+  color: var(--brand);
+  margin-bottom: 10px;
+}
+
+/* ---------- 12. Responsive Adjustments ---------------------------------- */
+@media (max-width: 768px) {
+  .app-main {
+    padding: 20px 16px 40px;
+  }
+
+  .app-header__inner {
+    padding: 0 16px;
+    gap: 14px;
+  }
+
+  .page-head, .page-header, .admin-header {
+    flex-direction: column;
+    align-items: flex-start;
+  }
+
+  .kpi-grid, .admin-stats-grid {
+    grid-template-columns: 1fr;
+  }
+
+  .shifts-grid, .swaps-grid {
+    grid-template-columns: 1fr;
+  }
+}
+
+/* ---------- 13. Swaps Toolbar & Card Additions --------------------------- */
+.swaps-toolbar {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
