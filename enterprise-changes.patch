+  align-items: center;
+  gap: 8px;
+  flex-wrap: wrap;
+}
+
+.swaps-filter-control {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  height: 38px;
+  padding: 0 10px;
+  background: var(--surface-2);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-sm);
+  font-size: 12.5px;
+  color: var(--text-2);
+}
+
+.swaps-filter-control:focus-within {
+  border-color: var(--brand);
+}
+
+.swaps-filter-control select {
