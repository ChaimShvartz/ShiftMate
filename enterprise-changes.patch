+  font-weight: 500;
+  cursor: pointer;
+  padding-inline-start: 4px;
+}
+
+.swaps-clear-btn {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  background: transparent;
+  border: 1px dashed var(--border-strong);
+  color: var(--text-2);
+  padding: 6px 12px;
+  border-radius: var(--radius-sm);
+  font-size: 12px;
+  cursor: pointer;
+  transition: all 0.15s ease;
+}
+
+.swaps-clear-btn:hover {
+  color: var(--danger);
+  border-color: var(--danger);
+  background: var(--danger-soft);
+}
+
+.chip--unit {
+  background: var(--surface-2);
+  color: var(--text-2);
+  border: 1px solid var(--border);
+}
+
+.swap-card__private-reason {
+  background: var(--surface-2);
+  border-radius: var(--radius-sm);
+  padding: 8px 12px;
+  border-inline-start: 3px solid var(--brand);
+}
+
+.swap-card__private-tag {
+  display: block;
+  font-size: 11px;
+  font-weight: 600;
+  color: var(--brand);
+  margin-bottom: 2px;
+}
+
+.login-quick-chips {
+  margin-top: 14px;
+  padding-top: 14px;
+  border-top: 1px dashed var(--border);
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+}
+
+.login-quick-chips__label {
+  font-size: 11px;
+  font-weight: 500;
+  color: var(--text-3);
+}
+
+.login-quick-chips__list {
+  display: flex;
+  gap: 6px;
+  flex-wrap: wrap;
+}
+
+.login-quick-chip {
+  background: var(--surface-2);
+  border: 1px solid var(--border);
+  color: var(--text-2);
+  border-radius: var(--radius-sm);
+  padding: 4px 8px;
+  font-size: 11.5px;
+  cursor: pointer;
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  transition: all 0.15s ease;
+}
+
+.login-quick-chip:hover {
+  background: var(--surface-3);
+  border-color: var(--border-strong);
+  color: var(--text);
+}
+
+.login-quick-chip strong {
+  font-family: var(--font-mono);
+  color: var(--brand);
+}
+
